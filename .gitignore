!tools/patch-publisher/PATCH-FILES/element/PLACE-FILES-HERE.txt
!tools/patch-publisher/PATCH-FILES/launcher/PLACE-FILES-HERE.txt
!tools/patch-publisher/PATCH-FILES/patcher/PLACE-FILES-HERE.txt

