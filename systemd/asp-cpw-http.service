[Unit]
Description=ASP CPW standalone read-only patch service
After=network.target asp-cpw-control.path

[Service]
Type=simple
User=nobody
Group=nogroup
EnvironmentFile=-/etc/asp-cpw/asp-cpw.env
ExecStart=/usr/bin/python3 /opt/asp-cpw/scripts/asp_cpw_http.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
